generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- TABEL KATEGORI BARANG ---
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  items       Item[]   // Relasi: Banyak Kategori punya banyak Barang (Many-to-Many)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- TABEL BARANG (ASET) ---
model Item {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  quantity    Int      @default(0)
  status      String   @default("AVAILABLE")
  
  imageUrl    String?  // Kolom foto baru
  
  categories  Category[] // Relasi Many-to-Many
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rentedQuantity      Int      @default(0) // <--- TAMBAH INI
  maintenanceQuantity Int      @default(0) // <--- TAMBAH INI
  price               Int?     @default(0) // <--- TAMBAH INI

}