// --- MODEL EVENT MANAGEMENT ---
model EventDetail {
  id               String                 @id @default(cuid())
  historyId        String?                @unique
  eventName        String
  durationDays     Int                    @default(1)
  clientBudget     Float?                 @default(0)
  notes            String?                @db.Text
  status           String                 @default("ACTIVE")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  crews            EventCrew[]
  sponsors         EventSponsor[]
  vendors          EventVendor[]
  manualEquipments EventManualEquipment[]
  utilities        EventUtility[]
  guestStars       EventGuestStar[]
  timelineItems    EventTimelineItem[]

  @@index([historyId])
}

model EventCrew {
  id            String      @id @default(cuid())
  eventDetailId String
  eventDetail   EventDetail @relation(fields: [eventDetailId], references: [id], onDelete: Cascade)
  name          String
  division      String
  memberCount   Int         @default(1)
  fee           Float       @default(0)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([eventDetailId])
}

model EventSponsor {
  id            String      @id @default(cuid())
  eventDetailId String
  eventDetail   EventDetail @relation(fields: [eventDetailId], references: [id], onDelete: Cascade)
  name          String
  supportType   String      @default("DANA")
  amount        Float       @default(0)
  status        String      @default("CONFIRMED")
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([eventDetailId])
}

model EventVendor {
  id            String      @id @default(cuid())
  eventDetailId String
  eventDetail   EventDetail @relation(fields: [eventDetailId], references: [id], onDelete: Cascade)
  name          String
  category      String
  cost          Float       @default(0)
  isErpPusat    Boolean     @default(false)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([eventDetailId])
}

model EventManualEquipment {
  id                String      @id @default(cuid())
  eventDetailId     String
  eventDetail       EventDetail @relation(fields: [eventDetailId], references: [id], onDelete: Cascade)
  name              String
  category          String
  quantity          Int         @default(1)
  procurementType   String
  unitPrice         Float       @default(0)
  rentalPricePerDay Float       @default(0)
  rentalDays        Int         @default(1)
  totalCost         Float       @default(0)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([eventDetailId])
}

model EventUtility {
  id                String      @id @default(cuid())
  eventDetailId     String
  eventDetail       EventDetail @relation(fields: [eventDetailId], references: [id], onDelete: Cascade)
  name              String
  category          String      // 'Konsumsi', 'Akomodasi', 'Transportasi', 'Kelistrikan & BBM', 'Komunikasi', 'Lainnya'
  quantity          Int         @default(1)
  unit              String?     @default("pcs") // 'pcs', 'porsi', 'kamar', 'liter', 'hari', dll.
  procurementType   String      @default("BELI") // 'BELI' or 'SEWA'
  unitPrice         Float       @default(0)
  rentalPricePerDay Float       @default(0)
  rentalDays        Int         @default(1)
  totalCost         Float       @default(0)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([eventDetailId])
  @@index([category])
}

model EventGuestStar {
  id             String                @id @default(cuid())
  eventDetailId  String
  eventDetail    EventDetail           @relation(fields: [eventDetailId], references: [id], onDelete: Cascade)
  name           String
  category       String                @default("BAND") // 'BAND', 'SOLO', 'DJ', 'MC_HOST', 'DANCE_PERFORMER', 'LAINNYA'
  personnelCount Int                   @default(1)
  contactPerson  String?
  feePerDay      Float                 @default(0)
  durationDays   Int                   @default(1)
  totalFee       Float                 @default(0)
  dayNumber      Int                   @default(1)
  stageTime      String?
  timelineSlots  String[]              @default([])
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  riders         EventGuestStarRider[]
  timelineItems  EventTimelineItem[]

  @@index([eventDetailId])
}

model EventGuestStarRider {
  id                String         @id @default(cuid())
  guestStarId       String
  guestStar         EventGuestStar @relation(fields: [guestStarId], references: [id], onDelete: Cascade)
  name              String
  riderType         String         @default("TECHNICAL") // 'TECHNICAL' or 'HOSPITALITY'
  sourceType        String         @default("VENDOR_LUAR") // 'ERP_LOGISTIK' or 'VENDOR_LUAR'
  quantity          Int            @default(1)
  unit              String?        @default("Unit")
  procurementType   String         @default("SEWA") // 'SEWA' or 'BELI' or 'FREE_ERP'
  unitPrice         Float          @default(0)
  rentalPricePerDay Float          @default(0)
  rentalDays        Int            @default(1)
  totalCost         Float          @default(0)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([guestStarId])
}

model EventTimelineItem {
  id            String          @id @default(cuid())
  eventDetailId String
  eventDetail   EventDetail     @relation(fields: [eventDetailId], references: [id], onDelete: Cascade)
  guestStarId   String?
  guestStar     EventGuestStar? @relation(fields: [guestStarId], references: [id], onDelete: SetNull)
  dayNumber     Int             @default(1)
  title         String
  category      String          @default("PERFORMANCE") // 'PERFORMANCE', 'SOUNDCHECK', 'BRIEFING', 'BREAK', 'OPENING', 'CLOSING', 'LAINNYA'
  startTime     String          // e.g. "20:00"
  endTime       String          // e.g. "21:30"
  slots         String[]        @default([]) // ["20:00", "20:30", "21:00"]
  stageLocation String?         @default("Main Stage")
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([eventDetailId])
  @@index([dayNumber])
}



