generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- TABEL KATEGORI BARANG ---
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  items       Item[]   // Relasi: Banyak Kategori punya banyak Barang (Many-to-Many)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- TABEL BARANG (ASET) ---
model Item {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  quantity    Int      @default(0)
  status      String   @default("AVAILABLE")
  
  imageUrl    String?  // Kolom foto baru
  
  categories  Category[] // Relasi Many-to-Many
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rentedQuantity      Int      @default(0) // <--- TAMBAH INI
  maintenanceQuantity Int      @default(0) // <--- TAMBAH INI
  price               Float?   @default(0) // <--- TAMBAH INI
  rentPercentage      Float?   @default(0) // <--- NILAI PERSENTASE SEWA

}

// --- TABEL RIWAYAT TRANSAKSI / INVOICE ---
model History {
  id          String   @id @default(cuid())
  type        String   // Misal: "INVOICE_RENTAL"
  date        DateTime @default(now())
  description String?
  payload     String?  @db.Text // Menyimpan snapshot barang yang dirental format JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- TABEL TEMPLATE PAKET RENTAL ---
model PackageTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String?
  payload       String   @db.Text // Menyimpan data isi paket berbentuk format JSON
  kategoriUtama String?  // Kategori utama tunggal (misal: 'Audio', 'Lighting', 'Stage')
  labelGrade    String[] @default([]) // Multi-label / grade (misal: ['Concert', 'Grade A', 'Outdoor'])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- TABEL MASTER KATEGORI UTAMA PAKET ---
model MasterCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- TABEL MASTER LABEL / GRADE PAKET ---
model MasterLabel {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}